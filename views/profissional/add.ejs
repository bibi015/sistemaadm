<%- include('../cabecalho.ejs') %>
<h1>Adicionar Profissional</h1>
<div><a href="/profissional/lst">Listar</a></div>
<div>
    <form method="post" action="/profissional/add">
        <label>Nome:</label>
        <input type="text" name="nome" required><br>
        <label>Especialidade:</label>
        <input type="text" name="especialidade" required><br>
        <label>Clientes:</label>
        <select name="clientes" multiple>
            <% clientes.forEach(cliente => { %>
                <option value="<%= cliente._id %>"><%= cliente.nome %></option>
            <% }) %>
        </select>
        <br><br>
        <button type="submit">Cadastrar</button>
    </form>
</div>
<%- include('../rodape.ejs') %>
